# Copy to .env and set values for this deployment. Do not put secrets here.
ARA_PUBLIC_URL=https://ara.example.internal
ARA_OIDC_ISSUER_URL=https://issuer.example.internal
ARA_OIDC_CLIENT_ID=ara
ARA_OIDC_SCOPES=openid profile email
ARA_AUDIT_RETENTION_DAYS=365
ARA_NOTIFICATION_REMINDER_OFFSETS_MINUTES=60 15 0

# Host paths may be absolute. The defaults are documented in deployment/README.md.
ARA_DATA_DIR=./data
ARA_CERTIFICATE_DIR=./certificates
CADDY_CERT_FILE=tls.crt
CADDY_KEY_FILE=tls.key
ARA_HTTPS_PORT=443

# Paths only; keep secret values in these files, never in this file.
ARA_OIDC_CLIENT_SECRET_FILE=./secrets/oidc_client_secret
ARA_SESSION_SECRET_FILE=./secrets/session_secret
ARA_OWNER_SUBJECTS_FILE=./secrets/owner_subjects
