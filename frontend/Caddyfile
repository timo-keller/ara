:443 {
	tls /certificates/{$CADDY_CERT_FILE:tls.crt} /certificates/{$CADDY_KEY_FILE:tls.key}

	encode zstd gzip

	@backend path /api/* /auth/*
	handle @backend {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
